# Copy to .env.local and fill in. All values are required at runtime.

# --- Public (exposed to the browser) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used to build tracking links in emails — must be the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=notifications@example.org
EMAIL_PASS=your-smtp-password
EMAIL_FROM="Content Request Portal <notifications@example.org>"
# Where new-request notifications go.
EMAIL_TO=team@example.org

# Bearer token for /api/cron/dispatch-notifications. At least 16 characters.
# Vercel sends this automatically for scheduled cron invocations.
CRON_SECRET=generate-a-long-random-string
